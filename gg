RunService.Heartbeat:Connect(function()
	if hitboxExpanderEnabled then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hrp = p.Character.HumanoidRootPart
				if not originalSizes[hrp] then originalSizes[hrp] = hrp.Size end
				hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
				hrp.Transparency = 0.6
				hrp.CanCollide = false
			end
		end
	else
		for hrp, orig in pairs(originalSizes) do
			if hrp and hrp.Parent then
				hrp.Size = orig
				hrp.Transparency = 1
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player then
			local char = p.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local isAlive = (char and rootPart and humanoid and humanoid.Health > 0)
			
			if not espStorage[p] then
				espStorage[p] = { Box = Drawing.new("Square"), Tracer = Drawing.new("Line"), Text = Drawing.new("Text") }
			end
			local visuals = espStorage[p]
			
			if isAlive and (espBoxEnabled or espTracerEnabled) then
				local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
				if onScreen then
					if espBoxEnabled then
						visuals.Box.Visible = true
						visuals.Box.Size = Vector2.new(40, 60)
						visuals.Box.Position = Vector2.new(vector.X - 20, vector.Y - 30)
						visuals.Box.Color = EspColor
						visuals.Box.Thickness = 1.5
					else
						visuals.Box.Visible = false
					end
					if espTracerEnabled then
						visuals.Tracer.Visible = true
						visuals.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
						visuals.Tracer.To = Vector2.new(vector.X, vector.Y + 30)
						visuals.Tracer.Color = EspColor
						visuals.Tracer.Thickness = 1.2
					else
						visuals.Tracer.Visible = false
					end
					visuals.Text.Visible = true
					visuals.Text.Text = p.Name
					visuals.Text.Size = 12
					visuals.Text.Center = true
					visuals.Text.Outline = true
					visuals.Text.Color = Color3.fromRGB(255, 255, 255)
					visuals.Text.Position = Vector2.new(vector.X, vector.Y - 45)
				else
					visuals.Box.Visible = false
					visuals.Tracer.Visible = false
					visuals.Text.Visible = false
				end
			else
				if visuals then
					visuals.Box.Visible = false
					visuals.Tracer.Visible = false
					visuals.Text.Visible = false
				end
			end
		end
	end
end)

