RunService.Heartbeat:Connect(function()
	local elapsed = math.floor(tick() - startTime)
	local hours = math.floor(elapsed / 3600)
	local minutes = math.floor((elapsed % 3600) / 60)
	local seconds = elapsed % 60
	uptimeVal.Text = string.format("%02d:%02d:%02d", hours, minutes, seconds)
	playersVal.Text = #Players:GetPlayers() .. " / " .. Players.MaxPlayers

	pcall(function()
		local networkPing = player:GetNetworkPing() * 1000
		pingVal.Text = string.format("%.0f ms", networkPing)
	end)

	frameCount = frameCount + 1
	if tick() - lastFpsUpdate >= 1 then
		fpsVal.Text = math.floor(frameCount / (tick() - lastFpsUpdate)) .. " FPS"
		frameCount = 0
		lastFpsUpdate = tick()
	end
end)

